# Claude Code hook events that run `sync`: right after a model switch, when a session starts,
# and on every prompt (a safety net in case a switch is made some other way).
# `python3 -I` (isolated mode) ignores PYTHONPATH, the current directory and user site-packages,
# so a planted module in a project folder can never run when a hook fires on every prompt.
SYNC_COMMAND = 'python3 -I "$HOME/.claude/bin/model-profile" sync 2>/dev/null || true'
CONTEXT_COMMAND = (
    'python3 -I "$HOME/.claude/bin/model-profile" context 2>/dev/null || true'
)
# Written by versions before 1.4.0: still recognised so upgrades and `off` clean them up.
