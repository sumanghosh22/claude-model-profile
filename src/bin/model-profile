EXIT_OK = 0
EXIT_FAILURE = 1
EXIT_USAGE = 2


class ProfileError(Exception):
    """A condition that must abort the command with a clear message."""


class BusyError(ProfileError):
    """Another model-profile run holds the lock."""


class SettingsChangedError(ProfileError):
    """settings.json was written by another program while this command was changing it."""


LOCK_POLL_SECONDS = 0.05


def warn(message: str) -> None:
    sys.stderr.write(f"model-profile: warning: {message}\n")


def acquire_flock(handle: IO[str], wait_seconds: float) -> bool:
    """Take an exclusive lock, waiting at most `wait_seconds`; False if it stayed busy."""
    give_up_at = time.monotonic() + wait_seconds
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            if time.monotonic() >= give_up_at:
                return False
            time.sleep(LOCK_POLL_SECONDS)


@contextmanager
def held_lock(path: Path, busy_message: str, wait_seconds: float) -> Iterator[None]:
    with path.open("a", encoding="utf-8") as handle:
        if not acquire_flock(handle, wait_seconds):
            raise BusyError(busy_message)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


@contextmanager
def exclusive_lock(wait_seconds: float = 0) -> Iterator[None]:
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    with held_lock(LOCK_FILE, "another model-profile run is in progress", wait_seconds):
        yield


def read_json_object(path: Path) -> JsonObject:
    try:
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise ProfileError(f"missing file: {path}") from None
    except (OSError, ValueError) as err:
        raise ProfileError(f"cannot read {path}: {err}") from err
    if not isinstance(parsed, dict):
        raise ProfileError(f"expected a JSON object in {path}")
    return parsed


def serialise_json(payload: JsonObject) -> bytes:
    """UTF-8 JSON that keeps non-ASCII text readable, escaping only what UTF-8 cannot hold.

    A lone surrogate (legal in JSON, impossible in UTF-8) would otherwise make the write fail.
    """
    try:
        text = json.dumps(payload, indent=JSON_INDENT, ensure_ascii=False)
        return (text + "\n").encode("utf-8")
    except UnicodeEncodeError:
        return (
            json.dumps(payload, indent=JSON_INDENT, ensure_ascii=True) + "\n"
        ).encode("ascii")


def write_json_atomic(path: Path, payload: JsonObject) -> None:
    """Replace `path` (following symlinks) durably, keeping its permission bits."""
    target = path.resolve()
    try:
        mode = stat.S_IMODE(target.stat().st_mode)
    except FileNotFoundError:
        mode = DEFAULT_FILE_MODE

    content = serialise_json(payload)
    descriptor, temp_name = tempfile.mkstemp(
        dir=target.parent, prefix=f".{target.name}.", suffix=".tmp"
    )
    temp_path = Path(temp_name)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_path, mode)
        temp_path.replace(target)
    except BaseException:
        temp_path.unlink(missing_ok=True)
        raise


SettingsSignature = tuple[int, int] | None


def settings_signature() -> SettingsSignature:
    """Identify the current settings.json (mtime and size) to detect a concurrent change."""
    try:
        stats = SETTINGS_FILE.resolve().stat()
    except FileNotFoundError:
        return None
    return (stats.st_mtime_ns, stats.st_size)


def write_settings_checked(payload: JsonObject, expected: SettingsSignature) -> None:
    """Refuse to overwrite a settings.json that changed since it was read.

    Claude Code and other tools write this file too; the check shrinks the window in which
    their change could be lost from "the whole command" to the instant before the swap.
    """
    if settings_signature() != expected:
        raise SettingsChangedError(
            "settings.json changed while it was being updated; run the command again"
        )
    write_json_atomic(SETTINGS_FILE, payload)


def read_settings() -> JsonObject:
    """Return settings.json, or an empty object when the file does not exist yet."""
    if not SETTINGS_FILE.exists():
        return {}
    return read_json_object(SETTINGS_FILE)


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(HASH_CHUNK_BYTES):
            digest.update(chunk)
    return digest.hexdigest()


def is_valid_agent_name(name: str) -> bool:
    return (
        name.endswith(AGENT_SUFFIX)
        and len(name) > len(AGENT_SUFFIX)
        and Path(name).name == name
    )


@dataclass(frozen=True)
class ProfileState:
    previous_settings: JsonObject
    installed_agents: dict[str, str]
    created_agents_dir: bool
    installed_skills: dict[str, str] = field(default_factory=dict)
    created_skills_dir: bool = False

    def to_json(self) -> JsonObject:
        return {
            "previous_settings": self.previous_settings,
            "installed_agents": self.installed_agents,
            "created_agents_dir": self.created_agents_dir,
            "installed_skills": self.installed_skills,
            "created_skills_dir": self.created_skills_dir,
        }


def load_state() -> ProfileState:
    raw = read_json_object(STATE_FILE)
    previous = raw.get("previous_settings")
    agents = raw.get("installed_agents")
    created_dir = raw.get("created_agents_dir")

    damaged = f"state file damaged ({STATE_FILE}); fix or delete it"
    if not isinstance(previous, dict) or not set(previous) <= set(PROFILE_SETTINGS):
        raise ProfileError(damaged)
    if not isinstance(agents, dict) or not all(
        is_valid_agent_name(name) and isinstance(digest, str)
        for name, digest in agents.items()
    ):
        raise ProfileError(damaged)
    if not isinstance(created_dir, bool):
        raise ProfileError(damaged)
    skills = raw.get(
        "installed_skills", {}
    )  # absent in state files written before 1.6.0
    created_skills = raw.get("created_skills_dir", False)
    if not isinstance(skills, dict) or not all(
        isinstance(name, str)
        and SKILL_NAME_PATTERN.fullmatch(name)
        and isinstance(digest, str)
        for name, digest in skills.items()
    ):
        raise ProfileError(damaged)
    if not isinstance(created_skills, bool):
        raise ProfileError(damaged)
    return ProfileState(previous, agents, created_dir, skills, created_skills)


def _is_routing_hook(entry: object, commands: frozenset[str] = KNOWN_COMMANDS) -> bool:
    return isinstance(entry, dict) and entry.get("command") in commands


def _group_has_command(group: object, command: str) -> bool:
    inner = group.get("hooks") if isinstance(group, dict) else None
    return isinstance(inner, list) and any(
        isinstance(entry, dict) and entry.get("command") == command for entry in inner
    )


def _group_has_routing_hook(
    group: object, commands: frozenset[str] = KNOWN_COMMANDS
) -> bool:
    inner = group.get("hooks") if isinstance(group, dict) else None
    return isinstance(inner, list) and any(
        _is_routing_hook(entry, commands) for entry in inner
    )


def _without_commands(groups: list[Any], commands: frozenset[str]) -> list[Any]:
    """Groups with the given hook commands removed; a group left empty is dropped."""
    kept: list[Any] = []
    for group in groups:
        if not _group_has_routing_hook(group, commands):
            kept.append(group)
            continue
        remaining = [e for e in group["hooks"] if not _is_routing_hook(e, commands)]
        if remaining:
            kept.append({**group, "hooks": remaining})
    return kept


def _hooks_section(settings: JsonObject) -> JsonObject:
    hooks = settings.get("hooks", {})
    if not isinstance(hooks, dict):
        raise ProfileError("settings.json `hooks` must be an object")
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            raise ProfileError(f"settings.json `hooks.{event}` must be a list")
    return hooks


def routing_hooks_installed(settings: JsonObject) -> bool:
    try:
        hooks = _hooks_section(settings)
    except ProfileError:
        return False
    return all(
        any(_group_has_command(group, command) for group in hooks.get(event, []))
        for event, commands in ROUTING_HOOKS.items()
        for command in commands
    )


def add_routing_hooks(settings: JsonObject) -> JsonObject:
    """Return settings with the routing hooks registered for every event (idempotent)."""
    settings = remove_routing_hooks(settings, LEGACY_COMMANDS)
    hooks = copy.deepcopy(_hooks_section(settings))
    for event in list(hooks):
        misplaced = ROUTING_COMMANDS - set(ROUTING_HOOKS.get(event, ()))
        hooks[event] = _without_commands(hooks[event], misplaced)
        if not hooks[event]:
            del hooks[event]
    for event, commands in ROUTING_HOOKS.items():
        groups = hooks.setdefault(event, [])
        for command in commands:
            if not any(_group_has_command(group, command) for group in groups):
                groups.append(
                    {
                        "hooks": [
                            {
                                "type": "command",
                                "command": command,
                                "timeout": HOOK_TIMEOUTS.get(
                                    command, HOOK_TIMEOUT_SECONDS
                                ),
                            }
                        ]
                    }
                )
    return {**settings, "hooks": hooks}


def remove_routing_hooks(
    settings: JsonObject, commands: frozenset[str] = KNOWN_COMMANDS
) -> JsonObject:
    """Return settings without our hook entries, leaving every other hook exactly as it was."""
    if "hooks" not in settings:
        return settings
    hooks = _hooks_section(settings)
    cleaned: JsonObject = {}
    for event, groups in hooks.items():
        kept = []
        for group in groups:
            if not _group_has_routing_hook(group, commands):
                kept.append(group)
                continue
            remaining = [e for e in group["hooks"] if not _is_routing_hook(e, commands)]
            if remaining:
                kept.append({**group, "hooks": remaining})
        if kept or not groups:
            cleaned[event] = kept if kept else groups
    if cleaned == hooks:
        return settings
    without_hooks = {key: value for key, value in settings.items() if key != "hooks"}
    if not cleaned:
        return without_hooks
    return {**settings, "hooks": cleaned}


def is_active() -> bool:
    return STATE_FILE.exists()


def profile_agent_files() -> list[Path]:
    files = sorted(PROFILE_AGENTS_DIR.glob(f"*{AGENT_SUFFIX}"))
    if not files:
        raise ProfileError(f"no agent files in {PROFILE_AGENTS_DIR}")
    return files


def copy_agent_exclusive(source: Path, destination: Path) -> None:
    """Create `destination` atomically; fails on any existing path, even a dangling symlink."""
    try:
        with source.open("rb") as reader, destination.open("xb") as writer:
            shutil.copyfileobj(reader, writer)
    except FileExistsError:
        raise ProfileError(
            f"refusing to overwrite existing file: {destination}"
        ) from None
    shutil.copystat(source, destination)


def profile_skill_names() -> list[str]:
    """Skills shipped with the profile (each a folder holding SKILL.md); optional."""
    if not PROFILE_SKILLS_DIR.is_dir():
        return []
    return sorted(
        d.name
        for d in PROFILE_SKILLS_DIR.iterdir()
        if d.is_dir()
        and not d.is_symlink()
        and SKILL_NAME_PATTERN.fullmatch(d.name)
        and (d / SKILL_FILE).is_file()
    )


def remove_empty_dir(directory: Path) -> None:
    if directory.is_symlink() or not directory.is_dir():
        return
    try:
        directory.rmdir()
    except OSError:
        return


def remove_installed_skills(skills: dict[str, str], created_root: bool) -> None:
    for name, expected_digest in skills.items():
        skill_dir = INSTALLED_SKILLS_DIR / name
        path = skill_dir / SKILL_FILE
        if os.path.lexists(path):
            just_created = expected_digest == ""  # rollback of a copy made moments ago
            modified = (
                path.is_symlink()
                or not path.is_file()
                or (not just_created and sha256_of(path) != expected_digest)
            )
            if modified:
                warn(f"left in place, modified since install: {path}")
                continue
            path.unlink()
        remove_empty_dir(skill_dir)
    if created_root:
        remove_empty_dir(INSTALLED_SKILLS_DIR)


def remove_empty_agents_dir() -> None:
    if INSTALLED_AGENTS_DIR.is_symlink() or not INSTALLED_AGENTS_DIR.is_dir():
        return
    try:
        INSTALLED_AGENTS_DIR.rmdir()
    except OSError:
        return


def rollback_enable(
    installed: dict[str, str],
    created_agents_dir: bool,
    skills: dict[str, str] | None = None,
    created_skills_dir: bool = False,
) -> None:
    try:
        remove_installed_skills(skills or {}, created_skills_dir)
    except OSError as err:
        warn(f"rollback could not remove skills: {err}")
    for name in installed:
        try:
            (INSTALLED_AGENTS_DIR / name).unlink(missing_ok=True)
        except OSError as err:
            warn(f"rollback could not remove {INSTALLED_AGENTS_DIR / name}: {err}")
    try:
        STATE_FILE.unlink(missing_ok=True)
    except OSError as err:
        warn(f"rollback could not remove {STATE_FILE}: {err}")
    if created_agents_dir:
        remove_empty_agents_dir()


def enable() -> None:
    if is_active():
        raise ProfileError("already ON. Run `off` first to reset.")

    sources = profile_agent_files()
    skill_names = profile_skill_names()
    conflicts = [
        INSTALLED_AGENTS_DIR / source.name
        for source in sources
        if os.path.lexists(INSTALLED_AGENTS_DIR / source.name)
    ] + [
        INSTALLED_SKILLS_DIR / name
        for name in skill_names
        if os.path.lexists(INSTALLED_SKILLS_DIR / name)
    ]
    if conflicts:
        raise ProfileError(
            "refusing to overwrite existing agent file(s): "
            + ", ".join(map(str, conflicts))
        )
    read_settings()

    created_agents_dir = not os.path.lexists(INSTALLED_AGENTS_DIR)
    created_skills_dir = bool(skill_names) and not os.path.lexists(INSTALLED_SKILLS_DIR)
    installed: dict[str, str] = {}
    skills: dict[str, str] = {}
    try:
        INSTALLED_AGENTS_DIR.mkdir(parents=True, exist_ok=True)
        for source in sources:
            destination = INSTALLED_AGENTS_DIR / source.name
            copy_agent_exclusive(source, destination)
            installed[source.name] = sha256_of(destination)
        for name in skill_names:
            skill_dir = INSTALLED_SKILLS_DIR / name
            skill_dir.mkdir(parents=True, exist_ok=False)
            skills[name] = ""  # recorded before the copy so a failure is rolled back
            copy_agent_exclusive(
                PROFILE_SKILLS_DIR / name / SKILL_FILE, skill_dir / SKILL_FILE
            )
            skills[name] = sha256_of(skill_dir / SKILL_FILE)

        signature = settings_signature()
        settings = read_settings()
        previous = {key: settings[key] for key in PROFILE_SETTINGS if key in settings}
        state = ProfileState(
            previous, installed, created_agents_dir, skills, created_skills_dir
        )
        write_json_atomic(STATE_FILE, state.to_json())
        write_settings_checked(
            add_routing_hooks({**settings, **PROFILE_SETTINGS}), signature
        )
    except BaseException:
        rollback_enable(installed, created_agents_dir, skills, created_skills_dir)
        raise


def restore_owned_settings(
    settings: JsonObject, previous: JsonObject
) -> tuple[JsonObject, list[str]]:
    """Undo the profile's keys in place, keeping any value the user changed since."""
    restored: JsonObject = {}
    kept_user_keys: list[str] = []
    for key, value in settings.items():
        if key not in PROFILE_SETTINGS:
            restored[key] = value
        elif value != PROFILE_SETTINGS[key]:
            restored[key] = value
            kept_user_keys.append(key)
        elif key in previous:
            restored[key] = previous[key]
    return restored, kept_user_keys


def remove_installed_agents(state: ProfileState) -> None:
    for name, expected_digest in state.installed_agents.items():
        path = INSTALLED_AGENTS_DIR / name
        if not os.path.lexists(path):
            continue
        if (
            path.is_symlink()
            or not path.is_file()
            or sha256_of(path) != expected_digest
        ):
            warn(f"left in place, modified since install: {path}")
            continue
        path.unlink()
    if state.created_agents_dir:
        remove_empty_agents_dir()


def disable() -> None:
    if not is_active():
        raise ProfileError("already OFF.")

    state = load_state()
    signature = settings_signature()
    settings = read_settings()
    restored, kept_user_keys = restore_owned_settings(settings, state.previous_settings)
    for key in kept_user_keys:
        warn(f"`{key}` was changed while the profile was ON; keeping your value")
    restored = remove_routing_hooks(restored)
    if restored != settings:
        write_settings_checked(restored, signature)

    remove_installed_agents(state)
    remove_installed_skills(state.installed_skills, state.created_skills_dir)
    STATE_FILE.unlink()


def routing_drift(settings: JsonObject) -> list[str]:
    """Describe each routing setting that no longer matches the profile while routing is ON."""
    return [
        f"`{key}` is {settings.get(key, '(default)')} (expected {expected})"
        for key, expected in PROFILE_SETTINGS.items()
        if settings.get(key) != expected
    ]


def repair() -> None:
    """Re-apply the routing settings without touching what was saved for `off`."""
    if not is_active():
        raise ProfileError(
            "routing is OFF; nothing to repair. Run `on` to switch it on."
        )
    signature = settings_signature()
    settings = read_settings()
    repaired = refresh_installed_hooks({**settings, **PROFILE_SETTINGS})
    if repaired != settings:
        write_settings_checked(repaired, signature)


def describe_status() -> str:
    settings = read_settings()
    lines = [
        f"profile: {'ON' if is_active() else 'OFF'}",
        f"model: {settings.get('model', '(default)')}",
        f"effortLevel: {settings.get('effortLevel', '(default)')}",
    ]
    if is_active():
        lines.append("subagents: " + ", ".join(load_state().installed_agents))
        lines.extend([MEANING_WHEN_ON, NEXT_WHEN_ON])
        lines.append(
            "auto-off: active (routing switches itself off if you choose another model)"
            if routing_hooks_installed(settings)
            else "auto-off: inactive (run `/model-profile repair`, then restart)"
        )
        lines.append(
            "effort: high by default; complex -> deep-work skill (high); "
            "critical -> critical-work skill (Opus, high)"
        )
        lines.append(
            "review gate: active (Opus reviews every finished task that changed files)"
            if routing_hooks_installed(settings)
            else "review gate: inactive (run `/model-profile repair`, then restart)"
        )
        lines.append(
            "standards: active (added to each new conversation)"
            if STANDARDS_FILE.is_file()
            else f"standards: missing ({STANDARDS_FILE}); reinstall to restore"
        )
        drift = routing_drift(settings)
        if drift:
            lines.append(
                "warning: routing is ON but "
                + "; ".join(drift)
                + ". Something changed it, "
                "for example choosing a model with /model. Run `/model-profile repair` to re-apply."
            )
    else:
        lines.extend([MEANING_WHEN_OFF, NEXT_WHEN_OFF])
    lines.append(describe_auto_update())
    return "\n".join(lines)


def record_history(state: str, reason: str | None = None) -> None:
    """Append an ON/OFF event to the local history log."""
    event = {"ts": datetime.now(timezone.utc).isoformat(), "state": state}
    if reason is not None:
        event["reason"] = reason
    try:
        with HISTORY_FILE.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(event) + "\n")
    except OSError as err:
        warn(f"could not record usage history: {err}")


def run_mutation(action: Callable[[], None], resulting_state: str) -> int:
    with exclusive_lock():
        action()
        record_history(resulting_state)
    notice = APPLY_HERE_NOTICE if resulting_state == "on" else RESTART_NOTICE
    sys.stdout.write(describe_status() + "\n" + notice + "\n")
    return EXIT_OK


def log_sync_event(level: str, event: str, **fields: object) -> None:
    """Append one JSON line to sync.log (size-capped); a failure is reported on stderr."""
    entry = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "level": level,
        "event": event,
        **fields,
    }
    try:
        if SYNC_LOG.exists() and SYNC_LOG.stat().st_size > SYNC_LOG_MAX_BYTES:
            # one atomic rename keeps the previous log as sync.log.1 and loses nothing
            os.replace(SYNC_LOG, SYNC_LOG.with_name(SYNC_LOG.name + ".1"))
        with SYNC_LOG.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry, ensure_ascii=True) + "\n")
    except (OSError, ValueError) as err:
        sys.stderr.write(f"model-profile: cannot write {SYNC_LOG}: {err}\n")


def sync() -> str | None:
    """Switch routing OFF if the user has chosen another model; return the message to show.

    Your choice is kept: `disable()` never overwrites a model you picked while routing was ON.
    """
    if not is_active():
        return None
    with exclusive_lock():
        if not is_active():
            return None
        chosen = read_settings().get("model")
        if chosen == PROFILE_SETTINGS["model"]:
            return None
        disable()
        record_history("off", reason="model_changed")
    if chosen is None:
        label = "the default model"
    elif isinstance(chosen, str) and MODEL_LABEL_PATTERN.fullmatch(chosen):
        label = f"`{chosen}`"
    else:
        label = "an unrecognised model"  # never echo odd characters back into the UI
    return (
        f"Routing switched OFF because you chose {label}. Your choice is kept. "
        "Run /model-profile on to switch routing back on."
    )


def hook_payload_models() -> dict[str, str]:
    """From the hook's stdin, keep only the event name and model-looking string fields.

    Everything else (notably prompt text) is discarded and never logged.
    """
    if sys.stdin.isatty():
        return {}
    try:
        payload = json.loads(sys.stdin.read(DEBUG_PAYLOAD_MAX_BYTES) or "null")
    except (OSError, ValueError, RecursionError):
        return {}
    if not isinstance(payload, dict):
        return {}
    return {
        key: value
        for key, value in payload.items()
        if isinstance(value, str)
        and (key == "hook_event_name" or "model" in key.lower())
    }


def log_hook_invocation() -> None:
    """Diagnostics (only while the `debug` flag file exists): what each hook run saw."""
    try:
        settings_model = read_settings().get("model")
    except (ProfileError, OSError, ValueError):
        settings_model = "<unreadable>"
    log_sync_event(
        "debug",
        "hook_invoked",
        hook=hook_payload_models(),
        settings_model=settings_model,
        routing_on=is_active(),
    )


def run_sync() -> int:
    """Hook entry point: never fails and prints nothing unless it changed something."""
    if DEBUG_FLAG.exists():
        try:
            log_hook_invocation()
        except (ProfileError, OSError, ValueError) as err:
            log_sync_event("error", "debug_log_failed", error=str(err))
    try:
        message = sync()
    except BusyError:
        return EXIT_OK
    except (ProfileError, OSError, ValueError) as err:
        log_sync_event("error", "sync_failed", error=str(err))
        return EXIT_OK
    if message is not None:
        log_sync_event("info", "auto_off", message=message)
        sys.stdout.write(json.dumps({"systemMessage": message}) + "\n")
    return EXIT_OK


# --------------------------------------------------------------------------------------
# Opus review gate. `snapshot` (UserPromptSubmit) records the git state when a task starts;
# `review-gate` (Stop) blocks the finish when files changed and no Opus review approved them.
# Questions that change nothing are never reviewed, so they cost nothing.
# --------------------------------------------------------------------------------------


def read_hook_payload() -> JsonObject:
    """The JSON object Claude Code sends a hook on stdin, or {} when absent or unreadable."""
    if sys.stdin.isatty():
        return {}
    try:
        payload = json.loads(sys.stdin.read(HOOK_STDIN_MAX_BYTES) or "null")
    except (OSError, ValueError, RecursionError):
        return {}
    return payload if isinstance(payload, dict) else {}


def run_git(repo: str, *args: str) -> str | None:
    """Run git with repository-configured command hooks disabled; None on any failure."""
    try:
        result = subprocess.run(  # nosec B603 - fixed argv, no shell; repo hooks disabled
            ["git", *GIT_SAFE_OPTIONS, "-C", repo, *args],
            capture_output=True,
            encoding="utf-8",
            errors="surrogateescape",
            timeout=GIT_TIMEOUT_SECONDS,
            check=False,
            env={**os.environ, "GIT_OPTIONAL_LOCKS": "0", "GIT_TERMINAL_PROMPT": "0"},
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout if result.returncode == 0 else None


def parse_porcelain_z(output: str) -> list[str]:
    """Paths from `git status --porcelain=v1 -z` (renames and copies carry a second path)."""
    paths: list[str] = []
    entries = output.split("\0")
    index = 0
    while index < len(entries):
        entry = entries[index]
        index += 1
        if len(entry) < STATUS_PATH_OFFSET:
            continue
        paths.append(entry[STATUS_PATH_OFFSET:])
        if entry[0] in "RC" and index < len(entries):
            paths.append(entries[index])
            index += 1
    return paths


def file_digest(path: Path) -> str:
    try:
        if path.is_symlink():
            return "link:" + os.readlink(path)
        if not path.exists():
            return "deleted"
        stats = path.stat()
        if not path.is_file() or stats.st_size > HASH_MAX_BYTES:
            return f"meta:{stats.st_size}:{stats.st_mtime_ns}"
        return sha256_of(path)
    except OSError:
        return "unreadable"


@dataclass(frozen=True)
class TreeFingerprint:
    """The dirty files of a git working tree (with content hashes) and its HEAD."""

    root: str
    head: str
    files: dict[str, str]

    def to_json(self) -> JsonObject:
        return {"root": self.root, "head": self.head, "files": self.files}

    @staticmethod
    def from_json(raw: object) -> TreeFingerprint | None:
        if not isinstance(raw, dict):
            return None
        root, head, files = raw.get("root"), raw.get("head"), raw.get("files")
        if not (
            isinstance(root, str) and isinstance(head, str) and isinstance(files, dict)
        ):
            return None
        if not all(isinstance(k, str) and isinstance(v, str) for k, v in files.items()):
            return None
        return TreeFingerprint(root, head, files)


def tree_fingerprint(directory: str) -> TreeFingerprint | None:
    if not directory or not os.path.isdir(directory):
        return None
    root = run_git(directory, "rev-parse", "--show-toplevel")
    if root is None:
        return None
    root = root.strip()
    head = (run_git(root, "rev-parse", "--verify", "--quiet", "HEAD") or "").strip()
    status = run_git(root, "status", "--porcelain=v1", "-z", "--untracked-files=all")
    if status is None:
        return None
    paths = parse_porcelain_z(status)[:FINGERPRINT_MAX_FILES]
    return TreeFingerprint(root, head, {p: file_digest(Path(root) / p) for p in paths})


def changed_paths(before: TreeFingerprint, after: TreeFingerprint) -> set[str]:
    """Files whose content changed between two fingerprints, including commits made since."""
    changed = {
        path
        for path in set(before.files) | set(after.files)
        if before.files.get(path) != after.files.get(path)
        # a file dirty before and still identical now was not touched by this task
        and not (
            path not in after.files
            and before.files.get(path) == file_digest(Path(after.root) / path)
        )
    }
    if before.head and after.head and before.head != after.head:
        committed = run_git(
            after.root, "diff", "--name-only", "-z", before.head, after.head
        )
        changed |= {p for p in (committed or "").split("\0") if p}
    return changed


def changed_line_estimate(root: str, paths: list[str]) -> int:
    """Approximate added+deleted lines in `paths` (used only to choose the reviewer tier)."""
    sample = paths[:NUMSTAT_MAX_PATHS]
    output = run_git(root, "diff", "--numstat", "HEAD", "--", *sample) or ""
    total = 0
    counted: set[str] = set()
    for line in output.splitlines():
        parts = line.split("\t")
        if len(parts) == 3:
            counted.add(parts[2])
            total += sum(int(n) for n in parts[:2] if n.isdigit())
    for path in sample:
        if path in counted:
            continue
        try:
            with (Path(root) / path).open("rb") as handle:
                total += sum(
                    1 for _ in zip(range(LINE_COUNT_CAP), handle, strict=False)
                )
        except OSError:
            continue
    return total


@dataclass(frozen=True)
class ReviewCall:
    agent: str
    changes_required: bool


@dataclass(frozen=True)
class TurnActivity:
    edited_files: list[str]
    reviews: list[ReviewCall]
    verified_after_last_edit: bool = False
    tool_calls: int = 0
    final_text: str = ""
    last_check_ok: bool | None = None


def _entry_content(entry: JsonObject) -> object:
    """The message content of a transcript entry; None when the entry is not shaped as expected."""
    message = entry.get("message")
    return message.get("content") if isinstance(message, dict) else None


def _is_real_prompt(entry: JsonObject) -> bool:
    if entry.get("type") != "user" or entry.get("isSidechain") or entry.get("isMeta"):
        return False
    content = _entry_content(entry)
    if isinstance(content, str):
        return True
    return isinstance(content, list) and not any(
        isinstance(block, dict) and block.get("type") == "tool_result"
        for block in content
    )


def _result_text(block: JsonObject) -> str:
    content = block.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(
            part.get("text", "")
            for part in content
            if isinstance(part, dict) and isinstance(part.get("text"), str)
        )
    return ""


def _parse_transcript_lines(lines: list[bytes]) -> list[JsonObject]:
    entries: list[JsonObject] = []
    for raw in lines:
        if len(raw) > TRANSCRIPT_LINE_MAX_CHARS:
            continue
        try:
            entry = json.loads(raw)
        except (ValueError, RecursionError):
            continue
        if isinstance(entry, dict):
            entries.append(entry)
    return entries


def read_turn_entries(path: Path) -> list[JsonObject]:
    """Entries from the user's latest real prompt on, reading only the end of the file.

    A long session's transcript can be over a gigabyte; reading all of it took 37 s and
    7.7 GB. This reads backwards in growing steps, each byte read and parsed once, until it
    holds a real prompt, the whole file, or TURN_TAIL_MAX_BYTES.
    """
    size = path.stat().st_size
    start = size  # file offset where the bytes already read begin
    cut_line = b""  # the first, possibly incomplete, line of what has been read so far
    entries: list[JsonObject] = []
    window = TURN_TAIL_START_BYTES
    with path.open("rb") as handle:
        while True:
            target = max(0, size - min(window, TURN_TAIL_MAX_BYTES))
            if target < start:
                handle.seek(target)
                lines = (handle.read(start - target) + cut_line).split(b"\n")
                start = target
                cut_line = lines.pop(0) if start > 0 else b""
                entries = _parse_transcript_lines(lines) + entries
            if (
                start == 0
                or size - start >= TURN_TAIL_MAX_BYTES
                or any(_is_real_prompt(entry) for entry in entries)
            ):
                return entries
            window *= TURN_TAIL_GROWTH


def turn_activity(transcript_path: object) -> TurnActivity:
    """What happened since the user's latest prompt: file edits and reviewer calls."""
    empty = TurnActivity([], [], False)
    if not isinstance(transcript_path, str):
        return empty
    path = Path(transcript_path)
    try:
        if not path.resolve().is_relative_to((CLAUDE_DIR / "projects").resolve()):
            return empty
        entries = read_turn_entries(path)
    except OSError:
        return empty
    return summarise_turn(entries)


def summarise_turn(entries: list[JsonObject]) -> TurnActivity:
    """Edits, checks, reviews, tool calls and the final answer of the latest task in `entries`."""
    start = (
        max((i for i, e in enumerate(entries) if _is_real_prompt(e)), default=-1) + 1
    )
    edited: list[str] = []
    reviewer_ids: dict[str, str] = {}
    reviews: list[ReviewCall] = []
    check_ids: dict[str, int] = {}
    check_results: list[tuple[int, bool]] = []
    last_edit_position = -1
    position = 0
    tool_calls = 0
    final_text = ""
    for entry in entries[start:]:
        content = _entry_content(entry)
        if not isinstance(content, list):
            continue
        if entry.get("type") == "assistant":
            text = " ".join(
                block["text"]
                for block in content
                if isinstance(block, dict)
                and block.get("type") == "text"
                and isinstance(block.get("text"), str)
            )
            if text.strip():
                final_text = text
        for block in content:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "tool_use":
                position += 1
                if block.get("name") not in NON_EVIDENCE_TOOLS:
                    tool_calls += 1
                raw_input = block.get("input")
                tool_input: JsonObject = (
                    raw_input if isinstance(raw_input, dict) else {}
                )
                file_path = tool_input.get("file_path")
                subagent = tool_input.get("subagent_type")
                if block.get("name") in FILE_EDIT_TOOLS:
                    last_edit_position = position
                if block.get("name") in FILE_EDIT_TOOLS and isinstance(file_path, str):
                    edited.append(file_path)
                elif is_check_command(block.get("name"), tool_input):
                    check_ids[str(block.get("id"))] = position
                elif (
                    block.get("name") == "Agent"
                    and isinstance(subagent, str)
                    and subagent in REVIEWER_AGENTS
                ):
                    reviewer_ids[str(block.get("id"))] = subagent
            elif (
                block.get("type") == "tool_result"
                and str(block.get("tool_use_id")) in check_ids
            ):
                check_results.append(
                    (
                        check_ids[str(block.get("tool_use_id"))],
                        block.get("is_error") is not True,
                    )
                )
            elif (
                block.get("type") == "tool_result"
                and str(block.get("tool_use_id")) in reviewer_ids
            ):
                verdict_text = _result_text(block)
                reviews.append(
                    ReviewCall(
                        reviewer_ids[str(block.get("tool_use_id"))],
                        CHANGES_REQUIRED_MARKER in verdict_text,
                    )
                )
    later_checks = sorted(r for r in check_results if r[0] > last_edit_position)
    verified = bool(later_checks) and later_checks[-1][1]
    last_check_ok = max(check_results)[1] if check_results else None
    return TurnActivity(
        sorted(set(edited)),
        reviews,
        verified,
        tool_calls,
        final_text[:EVIDENCE_TEXT_MAX_CHARS],
        last_check_ok,
    )


def is_check_command(tool_name: object, tool_input: JsonObject) -> bool:
    """A foreground shell command that runs the project's tests, lint, type check or build."""
    command = tool_input.get("command")
    return (
        tool_name == "Bash"
        and isinstance(command, str)
        and tool_input.get("run_in_background") is not True
        and VERIFY_COMMAND_PATTERN.search(command) is not None
    )


@dataclass(frozen=True)
class SecretFinding:
    path: str
    line: int
    kind: str


def secret_kind(text: str) -> str | None:
    """The kind of credential a line seems to contain, never the value itself."""
    for kind, pattern in SECRET_PATTERNS:
        match = pattern.search(text)
        if match is None:
            continue
        evidence = text if kind == GENERIC_SECRET_KIND else match.group(0)
        if SECRET_PLACEHOLDER_PATTERN.search(evidence) is None:
            return kind
    return None


def _whole_file_lines(shown: str, path: Path) -> Iterator[tuple[str, int, str]]:
    try:
        with path.open("rb") as handle:
            raw = handle.read(SECRET_SCAN_MAX_BYTES)
    except OSError:
        return
    if b"\0" in raw:
        return
    for number, text in enumerate(raw.decode("utf-8", "replace").splitlines(), 1):
        yield shown, number, text


def added_lines(root: str | None, paths: list[str]) -> Iterator[tuple[str, int, str]]:
    """Lines the task added: the uncommitted git diff, or whole files git cannot diff."""
    sample = paths[:SECRET_SCAN_MAX_FILES]
    diffed: set[str] = set()
    if root is not None:
        output = (
            run_git(
                root,
                "diff",
                "-U0",
                "--no-color",
                "--no-ext-diff",
                "--no-textconv",
                "HEAD",
                "--",
                *sample,
            )
            or ""
        )
        current: str | None = None
        number = 0
        for line in output.splitlines():
            if line.startswith("+++ "):
                target = line[4:]
                current = target[2:] if target.startswith("b/") else None
                if current is not None:
                    diffed.add(current)
            elif line.startswith("@@"):
                hunk = HUNK_HEADER_PATTERN.match(line)
                number = int(hunk.group(1)) if hunk else 0
            elif line.startswith("+") and current is not None:
                yield current, number, line[1:]
                number += 1
    for path in sample:
        if path not in diffed:
            yield from _whole_file_lines(path, Path(root, path) if root else Path(path))


def find_secrets(root: str | None, paths: list[str]) -> list[SecretFinding]:
    findings: list[SecretFinding] = []
    for path, number, text in added_lines(root, paths):
        kind = secret_kind(text)
        if kind == GENERIC_SECRET_KIND and FIXTURE_PATH_PATTERN.search(path):
            continue
        if kind is not None:
            findings.append(SecretFinding(path, number, kind))
            if len(findings) >= SECRET_SCAN_MAX_FINDINGS:
                break
    return findings


def review_state_path(session_id: object) -> Path | None:
    if not isinstance(session_id, str) or not SESSION_ID_PATTERN.fullmatch(session_id):
        return None
    return REVIEW_DIR / f"{session_id}.json"


def prune_review_states(now: float) -> None:
    for state in REVIEW_DIR.glob("*.json"):
        try:
            if now - state.stat().st_mtime > REVIEW_STATE_MAX_AGE_SECONDS:
                state.unlink()
        except OSError as err:
            log_sync_event(
                "warn", "review_state_prune_failed", path=str(state), error=str(err)
            )


def choose_reviewer(paths: list[str], changed_lines: int) -> str:
    risky = any(RISKY_PATH_PATTERN.search(path) for path in paths)
    big = changed_lines > DEEP_REVIEW_MIN_LINES or len(paths) > DEEP_REVIEW_MIN_FILES
    return DEEP_REVIEWER if risky or big else STANDARD_REVIEWER


def _display_path(path: str) -> str:
    printable = "".join(ch for ch in path if ch.isprintable() and ch != "`")
    return printable[:PATH_DISPLAY_MAX_CHARS]


def review_instruction(agent: str, after_changes_required: bool) -> str:
    if after_changes_required:
        return (
            "The last review requested changes. Fix every confirmed blocker or major finding, "
            f"re-run the checks, then call the {agent} agent again on the updated diff"
            " with the task goal, the file list and the `git diff` (plus the content of new files)."
            f" The reviewer checks every scenario for a test ({SCENARIO_REVIEW_NOTE})."
        )
    return (
        f"An Opus review is required before you finish. Call the {agent} agent with the task "
        "goal, the file list and the `git diff` (plus the content of new files). Fix every "
        "confirmed blocker or major finding and re-verify. "
        f"The reviewer checks every scenario for a test ({SCENARIO_REVIEW_NOTE})."
    )


def gate_instruction(
    paths: list[str],
    secrets: list[SecretFinding],
    needs_check: bool,
    review: str | None,
) -> str:
    shown = ", ".join(f"`{_display_path(p)}`" for p in paths[:REASON_MAX_FILES])
    more = (
        f" and {len(paths) - REASON_MAX_FILES} more"
        if len(paths) > REASON_MAX_FILES
        else ""
    )
    steps: list[str] = []
    if secrets:
        places = ", ".join(
            f"`{_display_path(f.path)}:{f.line}` ({f.kind})" for f in secrets
        )
        steps.append(
            f"Possible secret added at {places}. Remove it and load it from the environment "
            "or a secret store instead; never repeat the value. If it is a deliberate test "
            "fixture, say so in your final answer."
        )
    if needs_check:
        steps.append(
            "No passing test, lint, type-check or build run was seen after your last edit. "
            "Run the project's own checks now and show the command and its result. If the "
            "project has no checks, say so in your final answer."
        )
    if review is not None:
        steps.append(review)
    numbered = " ".join(f"{i}. {step}" for i, step in enumerate(steps, 1))
    return (
        f"Model routing review gate: this task changed {len(paths)} file(s): {shown}{more}. "
        f"Before you finish: {numbered} Then finish, quoting the check result and the "
        "review verdict in your final answer."
    )


def secret_key(finding: SecretFinding) -> str:
    return f"{finding.path}:{finding.kind}"


def secret_reminder(findings: list[SecretFinding]) -> JsonObject | None:
    """Already flagged once and Claude chose to keep it: let it finish, but tell the user."""
    if not findings:
        return None
    places = ", ".join(
        f"`{_display_path(f.path)}:{f.line}` ({f.kind})" for f in findings
    )
    log_sync_event("warn", "secret_left_in_change", findings=len(findings))
    return {
        "systemMessage": f"Model routing: possible secret still in the change at {places}. "
        "Check it before you commit."
    }


def give_up_notice(
    blocks: int, secrets: bool, needs_check: bool, needs_review: bool
) -> str:
    missing = [
        label
        for label, flag in (
            ("a possible secret is still in the change", secrets),
            ("no passing check run was seen", needs_check),
            ("the Opus review did not approve this change", needs_review),
        )
        if flag
    ]
    return (
        f"Model routing: the review gate asked {blocks} times; "
        + "; ".join(missing)
        + ". Treat it as unreviewed."
    )


def review_gate_decision(
    payload: JsonObject, now: float, activity: TurnActivity | None = None
) -> JsonObject | None:
    """The Stop-hook output: a block with instructions, a notice, or None to allow."""
    if not is_active():
        return None
    state_path = review_state_path(payload.get("session_id"))
    if state_path is None:
        return None
    state = read_json_object(state_path) if state_path.is_file() else {}
    before = TreeFingerprint.from_json(state.get("fingerprint"))
    if activity is None:
        activity = turn_activity(payload.get("transcript_path"))
    after = tree_fingerprint(before.root) if before is not None else None
    root: str | None = None
    if before is not None and after is not None:
        root = after.root
        paths = sorted(changed_paths(before, after))
        lines = changed_line_estimate(root, paths) if paths else 0
    else:
        paths, lines = activity.edited_files, 0
    if not paths:
        return None
    all_secrets = find_secrets(root, paths)
    raw_flagged = state.get("secrets_flagged")
    flagged = set(raw_flagged) if isinstance(raw_flagged, list) else set()
    secrets = [f for f in all_secrets if secret_key(f) not in flagged]
    needs_check = not activity.verified_after_last_edit and not all(
        DOC_ONLY_PATH_PATTERN.search(path) for path in paths
    )
    last_review = activity.reviews[-1] if activity.reviews else None
    needs_review = last_review is None or last_review.changes_required
    if not (secrets or needs_check or needs_review):
        return secret_reminder(all_secrets)
    blocks = state.get("blocks", 0) if isinstance(state.get("blocks"), int) else 0
    if blocks >= MAX_REVIEW_BLOCKS_PER_TASK:
        log_sync_event(
            "warn",
            "review_gate_gave_up",
            files=len(paths),
            blocks=blocks,
            secrets=len(secrets),
            unchecked=needs_check,
            unreviewed=needs_review,
        )
        return {
            "systemMessage": give_up_notice(
                blocks, bool(secrets), needs_check, needs_review
            )
        }
    agent = choose_reviewer(paths, lines)
    REVIEW_DIR.mkdir(parents=True, exist_ok=True)
    write_json_atomic(
        state_path,
        {
            **state,
            "blocks": blocks + 1,
            "updated": now,
            "secrets_flagged": sorted(flagged | {secret_key(f) for f in secrets}),
        },
    )
    log_sync_event(
        "info",
        "review_requested",
        agent=agent if needs_review else None,
        files=len(paths),
        lines=lines,
        secrets=len(secrets),
        unchecked=needs_check,
    )
    review = (
        review_instruction(agent, last_review is not None) if needs_review else None
    )
    return {
        "decision": "block",
        "reason": gate_instruction(paths, secrets, needs_check, review),
    }


def classify_prompt(text: object) -> tuple[str, list[str]]:
    """Routine, complex or critical, with the matched signals (keywords only, never prompt text).

    Conservative by design: a question that merely mentions a topic stays routine; escalation
    needs an action or a hard-problem signal, so cheap prompts are never upgraded.
    """
    if not isinstance(text, str) or not text.strip():
        return TRIAGE_ROUTINE, []
    critical = sorted({m.group(0).lower() for m in CRITICAL_TOPICS.finditer(text)})
    complex_hits = sorted({m.group(0).lower() for m in COMPLEX_SIGNALS.finditer(text)})
    data = sorted({m.group(0).lower() for m in DATA_TOPICS.finditer(text)})
    cues = sorted({m.group(0).lower() for m in ANALYSIS_CUES.finditer(text)})
    has_action = ACTION_WORDS.search(text) is not None
    repeated = REPEATED_FAILURE.search(text) is not None
    files = len({m.group(0) for m in CODE_PATH.finditer(text)})
    if repeated and (has_action or complex_hits or critical):
        return TRIAGE_CRITICAL, ["repeated failure", *critical][:TRIAGE_MAX_REASONS]
    if critical and (has_action or complex_hits):
        return TRIAGE_CRITICAL, critical[:TRIAGE_MAX_REASONS]
    stakes = data or [word for word in critical if word in PRODUCTION_WORDS]
    if cues and stakes:
        # reading evidence about a database or production system: a misread costs the most
        return TRIAGE_CRITICAL, [*cues[:2], *stakes[:1]][:TRIAGE_MAX_REASONS]
    long_prompt = len(text) > COMPLEX_PROMPT_CHARS
    if cues:
        return TRIAGE_COMPLEX, cues[:TRIAGE_MAX_REASONS]
    if (
        (complex_hits and (has_action or len(text) > MIN_PROMPT_CHARS_FOR_DESIGN_TALK))
        or files >= MULTI_FILE_THRESHOLD
        or (long_prompt and has_action)
    ):
        reasons = complex_hits or ([f"{files} files"] if files else ["long request"])
        return TRIAGE_COMPLEX, reasons[:TRIAGE_MAX_REASONS]
    return TRIAGE_ROUTINE, []


def valid_followup_state(raw: object, now: float) -> JsonObject | None:
    """The saved level of this conversation, if it is still fresh. The file is untrusted input."""
    if not isinstance(raw, dict):
        return None
    level, at, left = raw.get("level"), raw.get("at"), raw.get("left")
    reasons = raw.get("reasons")
    if (
        level not in (TRIAGE_COMPLEX, TRIAGE_CRITICAL)
        or isinstance(at, bool)
        or not isinstance(at, (int, float))
        or isinstance(left, bool)
        or not isinstance(left, int)
        or left <= 0
        or not 0 <= now - at <= FOLLOWUP_WINDOW_SECONDS
        or not isinstance(reasons, list)
    ):
        return None
    clean = [r for r in reasons if isinstance(r, str) and KEYWORD_PATTERN.fullmatch(r)]
    return {
        "level": level,
        "reasons": clean[:TRIAGE_MAX_REASONS],
        "at": at,
        "left": left,
    }


def is_on_topic(text: str) -> bool:
    """Does this follow-up talk about data, production, an analysis or a number?"""
    if (
        FOLLOWUP_SUBJECT.search(text) is not None
        and QUESTION_FORM.search(text) is not None
    ):
        return True
    return any(
        pattern.search(text) is not None
        for pattern in (
            DATA_TOPICS,
            CRITICAL_TOPICS,
            ANALYSIS_CUES,
            COMPLEX_SIGNALS,
            NUMBER_IN_TEXT,
        )
    )


def decide_triage(
    text: object, prior: object, now: float
) -> tuple[str, list[str], JsonObject | None]:
    """The level for this message and the conversation state to save (keywords, never text)."""
    level, reasons = classify_prompt(text)
    previous = valid_followup_state(prior, now)
    own_state: JsonObject = {
        "level": level,
        "reasons": reasons,
        "at": now,
        "left": FOLLOWUP_PROMPTS,
    }
    if previous is None:
        return level, reasons, own_state if level != TRIAGE_ROUTINE else None
    if TRIAGE_RANK[level] >= TRIAGE_RANK[previous["level"]]:
        return level, reasons, own_state if level != TRIAGE_ROUTINE else None
    stripped = text.strip() if isinstance(text, str) else ""
    if len(stripped) < MIN_FOLLOWUP_CHARS or CLOSING_PHRASE.fullmatch(stripped):
        return level, reasons, previous
    on_topic = is_on_topic(stripped)
    # a follow-up about the same subject keeps the stakes; a generic one drops a level and
    # uses up the memory faster, so a long chat does not stay expensive for its whole length
    inherited_level = (
        previous["level"]
        if on_topic
        else TRIAGE_RANKED[TRIAGE_RANK[previous["level"]] - 1]
    )
    if inherited_level == TRIAGE_ROUTINE:
        return level, reasons, {**previous, "at": now, "left": previous["left"] - 1}
    inherited = [f"follow-up to {previous['level']} work", *previous["reasons"]]
    cost = 1 if on_topic else OFF_TOPIC_FOLLOWUP_COST
    return (
        inherited_level,
        inherited[:TRIAGE_MAX_REASONS],
        {**previous, "at": now, "left": previous["left"] - cost},
    )


def triage_hint(level: str, reasons: list[str]) -> str | None:
    template = TRIAGE_HINTS.get(level)
    if template is None:
        return None
    return template.format(reasons=", ".join(reasons))


def prior_followup_state(payload: JsonObject) -> object:
    """What the previous message of this conversation was sized as, if recorded."""
    state_path = review_state_path(payload.get("session_id"))
    if state_path is None or not state_path.is_file():
        return None
    try:
        return read_json_object(state_path).get("triage")
    except ProfileError:
        return None


def take_snapshot(
    payload: JsonObject, triage: JsonObject | None = None, level: str | None = None
) -> None:
    """Remember the working tree as the task starts, for the review gate."""
    state_path = review_state_path(payload.get("session_id"))
    cwd = payload.get("cwd")
    if state_path is None or not isinstance(cwd, str):
        return
    try:
        fingerprint = tree_fingerprint(cwd)
    except (OSError, ValueError) as err:
        # still reset the per-message state, so this message is never judged by the last one
        log_sync_event("warn", "snapshot_fingerprint_failed", error=str(err))
        fingerprint = None
    now = datetime.now(timezone.utc).timestamp()
    REVIEW_DIR.mkdir(parents=True, exist_ok=True)
    write_json_atomic(
        state_path,
        {
            "fingerprint": fingerprint.to_json() if fingerprint else None,
            "blocks": 0,
            "evidence_blocks": 0,
            "updated": now,
            **({"turn_level": level} if level is not None else {}),
            **({"triage": triage} if triage is not None else {}),
        },
    )
    prune_review_states(now)


def run_prompt_start() -> int:
    """UserPromptSubmit hook, one process: auto-off check, snapshot, effort triage. Never fails."""
    payload = read_hook_payload()
    output: JsonObject = {}
    try:
        message = sync()
    except BusyError:
        message = None
    except (ProfileError, OSError, ValueError) as err:
        log_sync_event("error", "sync_failed", error=str(err))
        message = None
    if message is not None:
        log_sync_event("info", "auto_off", message=message)
        output["systemMessage"] = message
    try:
        if is_active():
            now = datetime.now(timezone.utc).timestamp()
            level, reasons, saved = decide_triage(
                payload.get("prompt"), prior_followup_state(payload), now
            )
            take_snapshot(payload, saved, level)
            hint = triage_hint(level, reasons)
            if hint is not None:
                output["hookSpecificOutput"] = {
                    "hookEventName": "UserPromptSubmit",
                    "additionalContext": hint,
                }
                log_sync_event("info", "triage", triage=level)
    except (ProfileError, OSError, ValueError, RecursionError) as err:
        log_sync_event("error", "prompt_start_failed", error=str(err))
    if output:
        sys.stdout.write(json.dumps(output) + "\n")
    return EXIT_OK


def run_snapshot() -> int:
    """Legacy (1.5.0) UserPromptSubmit hook: snapshot only. Kept until `repair` upgrades it."""
    try:
        if is_active():
            take_snapshot(read_hook_payload())
    except (ProfileError, OSError, ValueError, RecursionError) as err:
        log_sync_event("error", "snapshot_failed", error=str(err))
    return EXIT_OK


def asserts_pass(text: str) -> bool:
    """The answer states that tests or checks pass (not a wish, instruction or condition)."""
    for match in PASS_CLAIM.finditer(text):
        before = text[max(0, match.start() - CLAIM_CONTEXT_CHARS) : match.start()]
        boundaries = list(CLAUSE_END.finditer(before))
        clause = (
            before[boundaries[-1].end() :] if boundaries else before
        ) + match.group(0)
        if CONDITIONAL_WORDS.search(clause) is None:
            return True
    return False


def asserts_verification(text: str) -> bool:
    """The answer says it verified, ran or confirmed something, or that checks pass."""
    if PRIOR_WORK.search(text) is not None:
        return False
    return VERIFY_CLAIM.search(text) is not None or asserts_pass(text)


def evidence_issues(activity: TurnActivity, turn_level: object) -> list[str]:
    """What is wrong between this turn's answer and what actually ran. Exact checks only."""
    text = activity.final_text
    issues: list[str] = []
    if (
        turn_level == TRIAGE_CRITICAL
        and text
        and not activity.tool_calls
        and DATA_FACT_NUMBER.search(text) is not None
        and DATA_TOPICS.search(text) is not None
        and UNVERIFIED_MARKER.search(text) is None
    ):
        issues.append(EVIDENCE_DATA_ISSUE)
    if activity.last_check_ok is False and asserts_pass(text):
        issues.append(EVIDENCE_FAILED_CHECK_ISSUE)
    return issues


def evidence_gate_decision(
    payload: JsonObject, now: float, activity: TurnActivity | None = None
) -> JsonObject | None:
    """Every task, after it ends: compare what the answer claims with what actually ran.

    - Blocks once (never a loop) for an exact contradiction: tests said to pass although the
      last check of the turn failed, or, in critical work, facts about data with no tool run.
    - Only notifies when the answer says it verified something but no tool ran at all, because
      real answers often summarise earlier turns.
    Never reads the answer into a log or the state; fails open.
    """
    if not is_active():
        return None
    state_path = review_state_path(payload.get("session_id"))
    if state_path is None or not state_path.is_file():
        return None
    state = read_json_object(state_path)
    blocks = state.get("evidence_blocks", 0)
    if isinstance(blocks, bool) or not isinstance(blocks, int) or blocks < 0:
        return None
    if activity is None:
        activity = turn_activity(payload.get("transcript_path"))
    issues = (
        evidence_issues(activity, state.get("turn_level"))
        if blocks < EVIDENCE_BLOCKS_PER_TURN
        else []
    )
    if issues:
        write_json_atomic(
            state_path, {**state, "evidence_blocks": blocks + 1, "updated": now}
        )
        log_sync_event("info", "evidence_requested", issues=len(issues))
        numbered = " ".join(f"{i}. {text}" for i, text in enumerate(issues, 1))
        return {
            "decision": "block",
            "reason": f"Model routing evidence check: {numbered} {EVIDENCE_CLOSING}",
        }
    if (
        blocks == 0
        and state.get("claim_notice") is not True
        and activity.final_text
        and not activity.tool_calls
        and asserts_verification(activity.final_text)
    ):
        write_json_atomic(state_path, {**state, "claim_notice": True, "updated": now})
        log_sync_event("info", "claim_notice")
        return {"systemMessage": CLAIM_NOTICE}
    return None


def run_review_gate() -> int:
    """Stop hook: require an Opus review of changed files. Fails open (never traps a session)."""
    try:
        payload = read_hook_payload()
        now = datetime.now(timezone.utc).timestamp()
        if not is_active():
            return EXIT_OK
        activity = turn_activity(
            payload.get("transcript_path")
        )  # parsed once, used twice
        decision = review_gate_decision(payload, now, activity)
        if decision is None:
            decision = evidence_gate_decision(payload, now, activity)
    except (
        ProfileError,
        OSError,
        ValueError,
        RecursionError,
        TypeError,
        AttributeError,
        KeyError,
    ) as err:
        # a hook must never break the session: unexpected transcript shapes fail open, logged
        log_sync_event(
            "error", "review_gate_failed", error=f"{type(err).__name__}: {err}"
        )
        return EXIT_OK
    if decision is not None:
        sys.stdout.write(json.dumps(decision) + "\n")
    return EXIT_OK


def read_standards() -> str:
    """The routing standards text, capped so a careless edit cannot inflate every session."""
    text = STANDARDS_FILE.read_text(encoding="utf-8").strip()
    if len(text) > STANDARDS_MAX_CHARS:
        log_sync_event(
            "warn", "standards_truncated", chars=len(text), limit=STANDARDS_MAX_CHARS
        )
        return text[:STANDARDS_MAX_CHARS].rstrip()
    return text


def run_context() -> int:
    """SessionStart hook: print the routing standards so they enter the new conversation.

    Silent unless routing is ON and the model is still the profile's, and it never fails.
    """
    try:
        if not is_active() or read_settings().get("model") != PROFILE_SETTINGS["model"]:
            return EXIT_OK
        text = read_standards()
    except FileNotFoundError:
        log_sync_event("warn", "standards_missing", path=str(STANDARDS_FILE))
        return EXIT_OK
    except (ProfileError, OSError, ValueError) as err:
        log_sync_event("error", "context_failed", error=str(err))
        return EXIT_OK
    # a visible banner for the user, the standards as context for the model
    output: JsonObject = {"systemMessage": SESSION_BANNER}
    if text:
        output["hookSpecificOutput"] = {
            "hookEventName": SESSION_START_EVENT,
            "additionalContext": text,
        }
    sys.stdout.write(json.dumps(output) + "\n")
    return EXIT_OK


def run_statusline() -> int:
    """Status line entry point: a short ON/OFF tag, readable in any terminal. Never fails."""
    try:
        active = is_active()
    except OSError:
        active = False
    sys.stdout.write(STATUSLINE_TAG_ON if active else STATUSLINE_TAG_OFF)
    return EXIT_OK


def run_repair() -> int:
    with exclusive_lock():
        repair()
    sys.stdout.write(describe_status() + "\n" + APPLY_HERE_NOTICE + "\n")
    return EXIT_OK


def run_status() -> int:
    sys.stdout.write(describe_status() + "\n")
    return EXIT_OK


# ---------------------------------------------------------------------------------------------
# Automatic updates. Only installs that carry an update-channel file (the shareable builds)
# update themselves, from the GitHub releases named in it, and only to a release whose installer
# is signed by the key in that file: a hijacked GitHub account alone cannot push code to anyone.
# The version is read from the signed bytes, so an old signed installer cannot be replayed as a
# newer release to downgrade anyone or to slip a major version in.
# ---------------------------------------------------------------------------------------------
UPDATE_CHANNEL_FILE = PROFILE_DIR / "channel" / "update-channel.json"
UPDATE_STATE_FILE = PROFILE_DIR / "update-state.json"
UPDATE_LOCK_FILE = PROFILE_DIR / ".update.lock"
UPDATE_STATE_LOCK_FILE = PROFILE_DIR / ".update-state.lock"
UPDATE_DISABLE_ENV = "CLAUDE_MODEL_PROFILE_NO_AUTO_UPDATE"
UPDATE_API_ENV = "CLAUDE_MODEL_PROFILE_UPDATE_API"
DEFAULT_UPDATE_API = "https://api.github.com"
LOOPBACK_HOSTS = frozenset({"127.0.0.1", "localhost"})
HTTPS_SCHEME = "https"
LOOPBACK_SCHEME = "http"
BACKGROUND_UPDATE_COMMAND = "auto-update-run"
UPDATE_INTERVAL_SECONDS = 24 * 3600
UPDATE_RUN_BUDGET_SECONDS = 240
UPDATE_HTTP_TIMEOUT_SECONDS = 15
UPDATE_INSTALL_TIMEOUT_SECONDS = 90
UPDATE_SIGN_TIMEOUT_SECONDS = 30
DOWNLOAD_CHUNK_BYTES = 64 * 1024
MAX_RELEASE_JSON_BYTES = 1024 * 1024
MAX_INSTALLER_BYTES = 5 * 1024 * 1024
MAX_SIGNATURE_BYTES = 64 * 1024
MAX_REPORTED_ERROR_CHARS = 200
# install-hooks runs while sessions are open: their prompt hooks hold the profile lock briefly
HOOKS_LOCK_WAIT_SECONDS = 10
STATE_LOCK_WAIT_SECONDS = 5
HOOK_STATE_LOCK_WAIT_SECONDS = 1
UPDATER_ENV = "CLAUDE_MODEL_PROFILE_UPDATING"
SIGNED_HEADER_BYTES = 4096
SIGNATURE_IDENTITY = "claude-model-profile-release"
SIGNATURE_NAMESPACE = "claude-model-profile-release"
SIGNATURE_SUFFIX = ".sig"
UPDATE_USER_AGENT = "claude-model-profile-updater"
REPO_NAME_PATTERN = re.compile(r"^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$")
ASSET_NAME_PATTERN = re.compile(r"^[A-Za-z0-9._-]{1,100}\.sh$")
SIGNER_KEY_PATTERN = re.compile(
    r"^ssh-ed25519 [A-Za-z0-9+/]{68}(?: [A-Za-z0-9 ._@-]{0,80})?$"
)
RELEASE_VERSION_PATTERN = re.compile(r"^v?(\d{1,4})\.(\d{1,5})\.(\d{1,6})$")
SIGNED_VERSION_PATTERN = re.compile(
    rb"^# release-version: (\d{1,4}\.\d{1,5}\.\d{1,6})$", re.MULTILINE
)
KEYGEN_TOO_OLD = re.compile(r"(?:unknown|illegal|invalid) option", re.IGNORECASE)
UPDATED = "updated"
UP_TO_DATE = "up-to-date"
UPDATE_AVAILABLE = "available"
MAJOR_AVAILABLE = "major-available"
UPDATE_SKIPPED = "skipped"
NOTICE_STATUSES = frozenset({UPDATED, MAJOR_AVAILABLE})
UPDATE_NOT_INSTALLED_PREFIX = "Claude Model Profile: an update was not installed: "
# offline, rate-limited, cut short or out of time: tried again tomorrow, never shown to the user
TRANSIENT_UPDATE_ERRORS: tuple[type[Exception], ...] = (
    OSError,
    ValueError,
    http.client.HTTPException,
    subprocess.TimeoutExpired,
)
BACKGROUND_UPDATE_ERRORS: tuple[type[Exception], ...] = (
    ProfileError,
    *TRANSIENT_UPDATE_ERRORS,
)
Version = tuple[int, int, int]


class UpdateRefused(ProfileError):
    """A release that must not be installed: unsigned, wrongly signed, too big, malformed."""

    def __init__(self, message: str, release: str | None = None) -> None:
        super().__init__(message)
        self.release = release

    def notice(self) -> str:
        """One line for the user; names the release, so each new refusal is shown once."""
        if self.release is None:
            return f"{UPDATE_NOT_INSTALLED_PREFIX}{self}"
        return f"Claude Model Profile {self.release} was not installed: {self}"


@dataclass(frozen=True)
class UpdateChannel:
    repo: str
    asset: str
    signer: str


@dataclass(frozen=True)
class UpdateResult:
    status: str
    message: str = ""


def load_update_channel() -> UpdateChannel | None:
    """The release channel of a shareable build; None for installs that never self-update."""
    if not UPDATE_CHANNEL_FILE.is_file():
        return None
    data = read_json_object(UPDATE_CHANNEL_FILE)
    repo, asset, signer = data.get("repo"), data.get("asset"), data.get("signer")
    if not (
        isinstance(repo, str)
        and REPO_NAME_PATTERN.fullmatch(repo)
        and isinstance(asset, str)
        and ASSET_NAME_PATTERN.fullmatch(asset)
        and isinstance(signer, str)
        and SIGNER_KEY_PATTERN.fullmatch(signer)
    ):
        raise ProfileError(f"invalid update channel file: {UPDATE_CHANNEL_FILE}")
    return UpdateChannel(repo, asset, signer)


def parse_release_version(text: object) -> Version | None:
    match = RELEASE_VERSION_PATTERN.fullmatch(text) if isinstance(text, str) else None
    if match is None:
        return None
    major, minor, patch = (int(part) for part in match.groups())
    return major, minor, patch


def version_text(version: Version) -> str:
    return ".".join(str(part) for part in version)


def installed_release_version() -> Version | None:
    try:
        return parse_release_version(VERSION_FILE.read_text(encoding="utf-8").strip())
    except OSError:
        return None


def signed_release_version(installer: bytes) -> Version | None:
    """The version written into the installer's header, which the signature covers."""
    match = SIGNED_VERSION_PATTERN.search(installer[:SIGNED_HEADER_BYTES])
    return parse_release_version(match.group(1).decode("ascii")) if match else None


def _url_parts_are(url: str, scheme: str, hosts: frozenset[str] | None) -> bool:
    try:
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname
        user, password = parts.username, parts.password
    except ValueError:
        return False
    return (
        parts.scheme == scheme
        and bool(host)
        and (hosts is None or host in hosts)
        and user is None
        and password is None
    )


def is_https_url(url: str) -> bool:
    return _url_parts_are(url, HTTPS_SCHEME, None)


def is_loopback_http_url(url: str) -> bool:
    return _url_parts_are(url, LOOPBACK_SCHEME, LOOPBACK_HOSTS)


def is_allowed_update_url(url: object, base: str) -> bool:
    """https anywhere; plain http only to this machine, and only when the API is local (tests)."""
    return isinstance(url, str) and (
        is_https_url(url) or (is_loopback_http_url(base) and is_loopback_http_url(url))
    )


def update_api_base() -> str:
    """GitHub's API; the override exists only so tests can serve releases from this machine."""
    override = os.environ.get(UPDATE_API_ENV)
    if override is None:
        return DEFAULT_UPDATE_API
    if is_loopback_http_url(override):
        return override.rstrip("/")
    raise UpdateRefused(
        f"{UPDATE_API_ENV} must be a test server on this machine "
        "(http://127.0.0.1:<port>); remove it"
    )


class UpdateRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Follows a redirect (GitHub sends downloads to its file host) only to an allowed URL."""

    def __init__(self, base: str) -> None:
        super().__init__()
        self.base = base

    def redirect_request(
        self,
        req: urllib.request.Request,
        fp: IO[bytes],
        code: int,
        msg: str,
        headers: http.client.HTTPMessage,
        newurl: str,
    ) -> urllib.request.Request | None:
        if not is_allowed_update_url(newurl, self.base):
            raise UpdateRefused(
                "a download was redirected to an address that is not https"
            )
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def seconds_left(deadline: float) -> float:
    left = deadline - time.monotonic()
    if left <= 0:
        raise TimeoutError("the update ran out of time; it is tried again later")
    return left


def declared_length(headers: http.client.HTTPMessage) -> int | None:
    value = headers.get("Content-Length")
    return int(value) if isinstance(value, str) and value.isdigit() else None


def download(url: object, base: str, limit: int, deadline: float) -> bytes:
    """At most `limit` bytes over https, within the update's overall time budget."""
    if not is_allowed_update_url(url, base):
        raise UpdateRefused(
            "the release points to a download address that is not https"
        )
    assert isinstance(url, str)  # nosec B101 - narrowed by is_allowed_update_url
    opener = urllib.request.build_opener(UpdateRedirectHandler(base))
    request = urllib.request.Request(url, headers={"User-Agent": UPDATE_USER_AGENT})
    received = bytearray()
    with opener.open(  # nosec B310 - https only (checked above and on every redirect)
        request, timeout=min(UPDATE_HTTP_TIMEOUT_SECONDS, seconds_left(deadline))
    ) as response:
        expected = declared_length(response.headers)
        if expected is not None and expected > limit:
            raise UpdateRefused(f"a release file is larger than {limit} bytes")
        # read1 returns after each network read, so a server trickling bytes meets the deadline
        while chunk := response.read1(DOWNLOAD_CHUNK_BYTES):
            received += chunk
            if len(received) > limit:
                raise UpdateRefused(f"a release file is larger than {limit} bytes")
            seconds_left(deadline)
    if expected is not None and expected != len(received):
        raise ConnectionError("a download was cut short")
    return bytes(received)


def first_line(output: bytes) -> str:
    text = output.decode("utf-8", errors="replace").strip()
    return (text.splitlines() or ["unknown error"])[0][:MAX_REPORTED_ERROR_CHARS]


def verify_release_signature(
    installer: bytes, signature: bytes, signer: str, workdir: Path, deadline: float
) -> bool:
    """True only if `signature` is a valid signature of `installer` by the channel's key."""
    keygen = shutil.which("ssh-keygen")
    if keygen is None:
        raise UpdateRefused(
            "ssh-keygen is not installed, so the update cannot be verified"
        )
    allowed = workdir / "allowed_signers"
    allowed.write_text(
        f'{SIGNATURE_IDENTITY} namespaces="{SIGNATURE_NAMESPACE}" {signer}\n',
        encoding="utf-8",
    )
    signature_file = workdir / "installer.sig"
    signature_file.write_bytes(signature)
    result = subprocess.run(  # nosec B603 - fixed argv, no shell
        [
            keygen,
            "-Y",
            "verify",
            "-f",
            str(allowed),
            "-I",
            SIGNATURE_IDENTITY,
            "-n",
            SIGNATURE_NAMESPACE,
            "-s",
            str(signature_file),
        ],
        input=installer,
        capture_output=True,
        timeout=min(UPDATE_SIGN_TIMEOUT_SECONDS, seconds_left(deadline)),
        check=False,
    )
    if result.returncode == 0:
        return True
    detail = first_line(result.stderr)
    log_sync_event("warn", "update_signature_failed", detail=detail)
    if KEYGEN_TOO_OLD.search(detail):
        raise UpdateRefused(
            "ssh-keygen on this machine is too old to check signatures "
            "(OpenSSH 8.1 or newer is needed)"
        )
    return False


@contextmanager
def update_lock() -> Iterator[None]:
    """One update at a time; a second session stands back instead of waiting.

    The install folder is never created here: an update must not bring back a removed install.
    """
    with held_lock(UPDATE_LOCK_FILE, "another update is in progress", 0):
        yield


@contextmanager
def update_state_lock(wait_seconds: float = STATE_LOCK_WAIT_SECONDS) -> Iterator[None]:
    """Short read-modify-write of update-state.json; never held across network or install."""
    with held_lock(UPDATE_STATE_LOCK_FILE, "the update state is busy", wait_seconds):
        yield


def read_update_state() -> JsonObject:
    """The saved state; {} when there is none. A damaged file raises, so it is never
    overwritten with defaults that would silently undo the user's `auto-update-off`."""
    if not UPDATE_STATE_FILE.exists():
        return {}
    return read_json_object(UPDATE_STATE_FILE)


def auto_updates_enabled(state: JsonObject) -> bool:
    return not os.environ.get(UPDATE_DISABLE_ENV) and state.get("auto") is not False


def automatic_check_skipped(state: JsonObject, now: float) -> str | None:
    """Why an automatic check must not run now, or None when it is due."""
    if not auto_updates_enabled(state):
        return "automatic updates are off"
    checked = state.get("checked_at")
    if (
        isinstance(checked, (int, float))
        and not isinstance(checked, bool)
        and 0 <= now - checked < UPDATE_INTERVAL_SECONDS
    ):
        return "checked recently"
    return None


def claim_update_check(now: float, force: bool) -> str | None:
    """Record this attempt before any network use, unless another session just made one.

    Recording first means an unreachable server is tried again tomorrow, not every session.
    """
    with update_state_lock():
        state = read_update_state()
        skipped = None if force else automatic_check_skipped(state, now)
        if skipped is None:
            write_json_atomic(UPDATE_STATE_FILE, {**state, "checked_at": now})
    return skipped


def fetch_latest_release(
    channel: UpdateChannel, base: str, deadline: float
) -> JsonObject:
    raw = download(
        f"{base}/repos/{channel.repo}/releases/latest",
        base,
        MAX_RELEASE_JSON_BYTES,
        deadline,
    )
    try:
        release = json.loads(raw)
    except RecursionError as err:
        raise ValueError("the release information is nested too deeply") from err
    if not isinstance(release, dict):
        raise UpdateRefused("the release information is malformed")
    return release


def release_assets(release: JsonObject) -> dict[str, object]:
    raw_assets = release.get("assets")
    return {
        asset["name"]: asset.get("browser_download_url")
        for asset in (raw_assets if isinstance(raw_assets, list) else [])
        if isinstance(asset, dict) and isinstance(asset.get("name"), str)
    }


def install_release(
    channel: UpdateChannel,
    release: JsonObject,
    latest: Version,
    base: str,
    deadline: float,
) -> None:
    """Download, verify the signature and the signed version, then run the installer."""
    assets = release_assets(release)
    signature_name = channel.asset + SIGNATURE_SUFFIX
    if channel.asset not in assets or signature_name not in assets:
        raise UpdateRefused("the release has no signed installer")
    installer = download(assets[channel.asset], base, MAX_INSTALLER_BYTES, deadline)
    signature = download(assets[signature_name], base, MAX_SIGNATURE_BYTES, deadline)
    with tempfile.TemporaryDirectory(prefix="model-profile-update-") as tmp:
        workdir = Path(tmp)
        if not verify_release_signature(
            installer, signature, channel.signer, workdir, deadline
        ):
            raise UpdateRefused(
                "the installer's signature did not verify; not installed"
            )
        signed = signed_release_version(installer)
        if signed != latest:
            shown = version_text(signed) if signed else "unknown"
            raise UpdateRefused(
                f"the release is tagged {version_text(latest)} but its signed installer "
                f"is version {shown}; not installed"
            )
        if seconds_left(deadline) < UPDATE_INSTALL_TIMEOUT_SECONDS:
            raise TimeoutError("not enough time left to install; tried again later")
        path = workdir / channel.asset
        path.write_bytes(installer)
        returncode, stderr = run_installer(path)
    if returncode != 0:
        raise UpdateRefused(f"the installer stopped: {first_line(stderr)}")


def run_installer(path: Path) -> tuple[int, bytes]:
    """Run the verified installer in its own process group; a timeout ends all of it."""
    process = subprocess.Popen(  # nosec B603 B607 - runs the signature-verified installer
        ["bash", str(path), "--friendly"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env={**os.environ, UPDATER_ENV: "1"},
        start_new_session=True,
    )
    try:
        _, stderr = process.communicate(timeout=UPDATE_INSTALL_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        with suppress(ProcessLookupError):
            os.killpg(process.pid, signal.SIGKILL)
        process.communicate()
        raise
    return process.returncode, stderr


def register_installed_hooks() -> None:
    """Ask the just-installed version to register its hooks (its installer could not)."""
    result = subprocess.run(  # nosec B603 - this script with a fixed argument, no shell
        [sys.executable, "-I", str(Path(__file__).resolve()), "install-hooks"],
        capture_output=True,
        timeout=UPDATE_SIGN_TIMEOUT_SECONDS,
        check=False,
    )
    if result.returncode != 0:
        raise UpdateRefused(
            "it was installed, but its last setup step failed "
            f"({first_line(result.stderr)}); run the installer again"
        )


def check_for_update(now: float, install: bool, force: bool) -> UpdateResult:
    """One update check. `force` (a manual command) skips the daily limit and the off switch."""
    channel = load_update_channel()
    if channel is None:
        return UpdateResult(UPDATE_SKIPPED, "this install does not update itself")
    base = update_api_base()
    deadline = time.monotonic() + UPDATE_RUN_BUDGET_SECONDS
    with update_lock():
        skipped = claim_update_check(now, force)
        if skipped is not None:
            return UpdateResult(UPDATE_SKIPPED, skipped)
        release = fetch_latest_release(channel, base, deadline)
        latest = parse_release_version(release.get("tag_name"))
        if latest is None:
            raise UpdateRefused("the latest release has no version number")
        current = installed_release_version()
        if current is None and not force:
            raise UpdateRefused(
                "the installed version is unknown; run the installer again to keep updating"
            )
        name = version_text(latest)
        notes = f"https://github.com/{channel.repo}/releases/tag/v{name}"
        if current is not None and latest <= current:
            return UpdateResult(UP_TO_DATE, f"up to date ({version_text(current)})")
        if current is not None and latest[0] > current[0] and not force:
            return UpdateResult(
                MAJOR_AVAILABLE,
                f"Claude Model Profile {name} is a major update; it is not installed "
                f"automatically. Run /model-profile update to install it. Notes: {notes}",
            )
        if not install:
            return UpdateResult(
                UPDATE_AVAILABLE,
                f"{name} is available. Run /model-profile update. Notes: {notes}",
            )
        if load_update_channel() is None or not VERSION_FILE.is_file():
            return UpdateResult(UPDATE_SKIPPED, "the tool was removed meanwhile")
        try:
            install_release(channel, release, latest, base, deadline)
        except UpdateRefused as err:
            if installed_release_version() != latest:
                raise UpdateRefused(str(err), name) from err
            # the files are in place; only the installer's last step (hooks) failed
            try:
                register_installed_hooks()
            except UpdateRefused as hook_err:
                raise UpdateRefused(str(hook_err), name) from err
        if installed_release_version() != latest:
            raise UpdateRefused(
                "the installed version does not match the release", name
            )
        log_sync_event("info", "updated", version=name)
        return UpdateResult(
            UPDATED, f"Claude Model Profile updated to {name}. What changed: {notes}"
        )


def queue_notice(message: str) -> None:
    """Shown at the next conversation start; each distinct message once, never daily."""
    try:
        with update_state_lock():
            state = read_update_state()
            if state.get("announced") == message:
                return
            write_json_atomic(
                UPDATE_STATE_FILE, {**state, "announced": message, "pending": message}
            )
    except (ProfileError, OSError) as err:
        log_sync_event(
            "warn", "update_notice_lost", error=f"{type(err).__name__}: {err}"
        )


def take_pending_notice() -> str:
    with update_state_lock(HOOK_STATE_LOCK_WAIT_SECONDS):
        state = read_update_state()
        if "pending" not in state:
            return ""
        pending = state["pending"]
        write_json_atomic(
            UPDATE_STATE_FILE,
            {key: value for key, value in state.items() if key != "pending"},
        )
    return pending if isinstance(pending, str) else ""


def start_background_update() -> None:
    """The check runs detached, so a conversation never waits for the network or an install."""
    subprocess.Popen(  # nosec B603 - this script with a fixed argument, no shell
        [
            sys.executable,
            "-I",
            str(Path(__file__).resolve()),
            BACKGROUND_UPDATE_COMMAND,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        cwd=Path.home(),
        start_new_session=True,
        close_fds=True,
    )


def run_auto_update() -> int:
    """SessionStart hook: shows what the last background check found and starts the next."""
    try:
        if load_update_channel() is None:
            return EXIT_OK
        message = take_pending_notice()
    except (ProfileError, OSError, ValueError) as err:
        log_sync_event("warn", "update_failed", error=f"{type(err).__name__}: {err}")
        return EXIT_OK
    try:
        now = datetime.now(timezone.utc).timestamp()
        if automatic_check_skipped(read_update_state(), now) is None:
            start_background_update()
    except (ProfileError, OSError, ValueError, subprocess.SubprocessError) as err:
        log_sync_event("warn", "update_failed", error=f"{type(err).__name__}: {err}")
    if message:
        sys.stdout.write(json.dumps({"systemMessage": message}) + "\n")
    return EXIT_OK


def run_background_update() -> int:
    """The detached daily check: installs a signed release and queues one line for the user."""
    try:
        result = check_for_update(datetime.now(timezone.utc).timestamp(), True, False)
        if result.status in NOTICE_STATUSES:
            queue_notice(result.message)
    except BusyError:
        return EXIT_OK
    except UpdateRefused as err:
        log_sync_event("warn", "update_refused", release=err.release, error=str(err))
        queue_notice(err.notice())
    except BACKGROUND_UPDATE_ERRORS as err:
        log_sync_event("warn", "update_failed", error=f"{type(err).__name__}: {err}")
    return EXIT_OK


def run_manual_update(install: bool) -> int:
    """`update` / `update-check`: now, whatever the daily limit and the off switch say."""
    try:
        result = check_for_update(datetime.now(timezone.utc).timestamp(), install, True)
    except TRANSIENT_UPDATE_ERRORS as err:
        raise ProfileError(f"could not finish the update check: {err}") from err
    sys.stdout.write(result.message + "\n")
    return EXIT_OK


def update_hook_installed(settings: JsonObject) -> bool:
    try:
        hooks = _hooks_section(settings)
    except ProfileError:
        return False
    return any(
        _group_has_command(group, AUTO_UPDATE_COMMAND)
        for group in hooks.get(UPDATE_HOOK_EVENT, [])
    )


def with_update_hook(settings: JsonObject, wanted: bool) -> JsonObject:
    """Settings with the daily update hook registered (or removed); unchanged if already so."""
    if wanted and update_hook_installed(settings):
        return settings
    without = remove_routing_hooks(settings, UPDATE_COMMANDS)
    if not wanted:
        return without
    hooks = copy.deepcopy(_hooks_section(without))
    hooks.setdefault(UPDATE_HOOK_EVENT, []).append(
        {
            "hooks": [
                {
                    "type": "command",
                    "command": AUTO_UPDATE_COMMAND,
                    "timeout": HOOK_TIMEOUT_SECONDS,
                }
            ]
        }
    )
    return {**without, "hooks": hooks}


def refresh_installed_hooks(settings: JsonObject) -> JsonObject:
    """This version's hooks: the update hook for shareable builds, routing hooks while ON.

    A damaged channel file leaves the update hook as it is, so `repair` still fixes routing.
    """
    try:
        refreshed = with_update_hook(settings, load_update_channel() is not None)
    except ProfileError as err:
        log_sync_event("warn", "update_channel_damaged", error=str(err))
        refreshed = settings
    if not is_active():
        return refreshed
    return add_routing_hooks(with_current_profile_settings(refreshed))


def with_current_profile_settings(settings: JsonObject) -> JsonObject:
    """While ON, move a value an earlier version set (and the user left alone) to today's."""
    upgraded = {
        key: PROFILE_SETTINGS[key]
        for key, earlier in EARLIER_PROFILE_SETTINGS.items()
        if settings.get(key) == earlier
    }
    return {**settings, **upgraded} if upgraded else settings


def change_hooks(change: Callable[[JsonObject], JsonObject]) -> None:
    """Apply `change` to settings.json under the profile lock; writes only a real change.

    Runs unattended during updates, so it waits briefly for open sessions' hooks and tries
    again once if Claude Code saved settings.json at the same instant.
    """
    with exclusive_lock(HOOKS_LOCK_WAIT_SECONDS):
        apply_settings_change_with_retry(change)


def apply_settings_change_with_retry(
    change: Callable[[JsonObject], JsonObject],
) -> None:
    try:
        apply_settings_change(change)
    except SettingsChangedError:
        apply_settings_change(change)


def apply_settings_change(change: Callable[[JsonObject], JsonObject]) -> None:
    signature = settings_signature()
    settings = read_settings()
    changed = change(settings)
    if changed != settings:
        write_settings_checked(changed, signature)


def replace_copy(source: Path, destination: Path) -> str:
    """Atomically replace `destination` with `source`; returns the new copy's SHA-256."""
    descriptor, temp_name = tempfile.mkstemp(
        dir=destination.parent, prefix=f".{destination.name}.", suffix=".tmp"
    )
    temp_path = Path(temp_name)
    try:
        with os.fdopen(descriptor, "wb") as writer, source.open("rb") as reader:
            shutil.copyfileobj(reader, writer)
        shutil.copystat(source, temp_path)
        temp_path.replace(destination)
    except BaseException:
        temp_path.unlink(missing_ok=True)
        raise
    return sha256_of(destination)


def regular_file_digest(path: Path) -> str | None:
    """SHA-256 of a regular file that is not a link; None for anything else or unreadable."""
    try:
        if path.is_symlink() or not path.is_file():
            return None
        return sha256_of(path)
    except OSError as err:
        log_sync_event("warn", "copy_unreadable", path=str(path), error=str(err))
        return None


def refreshed_copies(
    recorded: dict[str, str],
    available: list[str],
    source_of: Callable[[str], Path],
    installed_copy_of: Callable[[str], Path],
    claim_of: Callable[[str], Path],
) -> dict[str, str]:
    """Bring the copies routing installed up to date with this version's files.

    A copy is ours only while its content is what was installed, or already this version's
    (a refresh that stopped before recording it). Anything else (edited, a link, a folder,
    unreadable or deleted) is left exactly as it is and stays recorded, so it is never added
    again and `off` still leaves it alone. A new file is added only where nothing with its
    name exists (`claim_of`: the agent file, or the whole skill folder); a file this version
    no longer ships is removed. Returns the new name -> SHA-256 record.
    """
    updated: dict[str, str] = {}
    for name, digest in recorded.items():
        installed = installed_copy_of(name)
        current = regular_file_digest(installed)
        shipped = sha256_of(source_of(name)) if name in available else None
        if current is None or current not in (digest, shipped):
            event = (
                "copy_left_modified" if os.path.lexists(installed) else "copy_deleted"
            )
            log_sync_event("warn", event, path=str(installed))
            updated[name] = digest
            continue
        if shipped is None:
            installed.unlink()
            if claim_of(name) != installed:
                remove_empty_dir(claim_of(name))
            continue
        updated[name] = (
            shipped if current == shipped else replace_copy(source_of(name), installed)
        )
    for name in available:
        installed = installed_copy_of(name)
        if name in recorded or os.path.lexists(claim_of(name)):
            continue
        installed.parent.mkdir(parents=True, exist_ok=True)
        try:
            copy_agent_exclusive(source_of(name), installed)
        except BaseException:
            if claim_of(name) != installed:
                remove_empty_dir(claim_of(name))
            raise
        updated[name] = sha256_of(installed)
    return updated


def refresh_installed_copies() -> None:
    """While routing is ON, give the installed agents and skills this version's content."""
    if not is_active():
        return
    state = load_state()
    agents_root_existed = os.path.lexists(INSTALLED_AGENTS_DIR)
    skills_root_existed = os.path.lexists(INSTALLED_SKILLS_DIR)
    agents = refreshed_copies(
        state.installed_agents,
        [path.name for path in profile_agent_files()],
        lambda name: PROFILE_AGENTS_DIR / name,
        lambda name: INSTALLED_AGENTS_DIR / name,
        lambda name: INSTALLED_AGENTS_DIR / name,
    )
    skills = refreshed_copies(
        state.installed_skills,
        profile_skill_names(),
        lambda name: PROFILE_SKILLS_DIR / name / SKILL_FILE,
        lambda name: INSTALLED_SKILLS_DIR / name / SKILL_FILE,
        lambda name: INSTALLED_SKILLS_DIR / name,
    )
    refreshed = replace(
        state,
        installed_agents=agents,
        installed_skills=skills,
        # a folder this refresh created is removed by `off` like one `on` created
        created_agents_dir=state.created_agents_dir
        or (not agents_root_existed and INSTALLED_AGENTS_DIR.is_dir()),
        created_skills_dir=state.created_skills_dir
        or (not skills_root_existed and INSTALLED_SKILLS_DIR.is_dir()),
    )
    if refreshed == state:
        return
    write_json_atomic(STATE_FILE, refreshed.to_json())
    log_sync_event("info", "copies_refreshed", agents=len(agents), skills=len(skills))


def run_install_hooks() -> int:
    """Run by the installer after every install or update, so an upgrade needs no off/on:
    this version's hooks, agents and skills. The hooks are registered even when the agents
    and skills cannot be refreshed; that failure is then reported, never hidden."""
    refresh_error: Exception | None = None
    with exclusive_lock(HOOKS_LOCK_WAIT_SECONDS):
        try:
            refresh_installed_copies()
        except (ProfileError, OSError) as err:
            log_sync_event("error", "copies_refresh_failed", error=str(err))
            refresh_error = err
        apply_settings_change_with_retry(refresh_installed_hooks)
    if refresh_error is not None:
        raise ProfileError(
            "hooks registered, but the helper agents and skills were not refreshed: "
            f"{refresh_error}"
        )
    return EXIT_OK


def run_uninstall_hooks() -> int:
    """Run by the installer before it removes the files: drops the update hook."""
    change_hooks(lambda settings: with_update_hook(settings, False))
    return EXIT_OK


def set_auto_update(enabled: bool) -> int:
    """An explicit choice; it also resets a damaged state file."""
    PROFILE_DIR.mkdir(parents=True, exist_ok=True)
    with update_state_lock():
        try:
            state = read_update_state()
        except ProfileError:
            state = {}
        write_json_atomic(UPDATE_STATE_FILE, {**state, "auto": enabled})
    if enabled and load_update_channel() is not None:
        change_hooks(lambda settings: with_update_hook(settings, True))
    sys.stdout.write(
        "Automatic updates are on.\n" if enabled else "Automatic updates are off.\n"
    )
    return EXIT_OK


def describe_auto_update() -> str:
    try:
        channel = load_update_channel()
    except ProfileError:
        return "auto-update: off (the update channel file is damaged; reinstall)"
    if channel is None:
        return "auto-update: not used by this install"
    try:
        state = read_update_state()
    except ProfileError:
        return (
            "auto-update: off (the update state file is damaged; "
            "`/model-profile auto-update-on` resets it)"
        )
    if not auto_updates_enabled(state):
        return "auto-update: off (`/model-profile auto-update-on` to switch it on)"
    try:
        registered = update_hook_installed(read_settings())
    except ProfileError:
        registered = False
    if not registered:
        return (
            "auto-update: inactive (run `/model-profile auto-update-on`, then restart)"
        )
    return f"auto-update: on, signed releases from github.com/{channel.repo}"


def run_version() -> int:
    try:
        version = VERSION_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        version = "unknown (not installed with the installer)"
    sys.stdout.write(f"claude-model-profile {version}\n")
    return EXIT_OK


def run_help() -> int:
    sys.stdout.write(USAGE + "\n")
    return EXIT_OK


def run_switch(turn_on: bool) -> int:
    """Switch routing on or off; asking for the state it is already in is a harmless no-op."""
    if is_active() == turn_on:
        sys.stdout.write(
            f"Routing is already {'ON' if turn_on else 'OFF'}; nothing changed.\n"
            + describe_status()
            + "\n"
            + (APPLY_HERE_NOTICE + "\n" if turn_on else "")
        )
        return EXIT_OK
    return run_mutation(enable if turn_on else disable, "on" if turn_on else "off")


COMMANDS: dict[str, Callable[[], int]] = {
    "on": lambda: run_switch(True),
    "off": lambda: run_switch(False),
    "status": run_status,
    "repair": run_repair,
    "sync": run_sync,
    "context": run_context,
    "statusline": run_statusline,
    "snapshot": run_snapshot,
    "prompt-start": run_prompt_start,
    "review-gate": run_review_gate,
    "auto-update": run_auto_update,
    BACKGROUND_UPDATE_COMMAND: run_background_update,
    "update": lambda: run_manual_update(True),
    "update-check": lambda: run_manual_update(False),
    "install-hooks": run_install_hooks,
    "uninstall-hooks": run_uninstall_hooks,
    "auto-update-on": lambda: set_auto_update(True),
    "auto-update-off": lambda: set_auto_update(False),
    "version": run_version,
    "--version": run_version,
    "help": run_help,
    "--help": run_help,
    "-h": run_help,
}
NO_ARGUMENT_COMMAND = "status"


PRIVATE_UMASK = 0o077


def main(argv: list[str]) -> int:
    os.umask(
        PRIVATE_UMASK
    )  # new files and folders are owner-only, whatever the shell's umask
    if os.geteuid() == 0 and os.environ.get("SUDO_USER"):
        sys.stderr.write(
            "model-profile: do not run with sudo; it would make your settings root-owned\n"
        )
        return EXIT_FAILURE
    command = (
        NO_ARGUMENT_COMMAND if len(argv) == 1 else argv[1] if len(argv) == 2 else None
    )
    handler = COMMANDS.get(command) if command is not None else None
    if handler is None:
        sys.stderr.write(f"usage: model-profile on|off|status|repair|help\n\n{USAGE}\n")
        return EXIT_USAGE
    try:
        return handler()
    except (ProfileError, OSError, ValueError) as err:
        sys.stderr.write(f"model-profile: {err}\n")
        return EXIT_FAILURE


if __name__ == "__main__":
    sys.exit(main(sys.argv))
