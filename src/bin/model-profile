        '"$HOME/.claude/bin/model-profile" sync 2>/dev/null || true',
        '"$HOME/.claude/bin/model-profile" context 2>/dev/null || true',
        # 1.5.0 ran a separate snapshot hook per prompt; 1.6.0 folds it into prompt-start
        'python3 -I "$HOME/.claude/bin/model-profile" snapshot 2>/dev/null || true',
    }
)
# event -> the hook commands registered for it. `context` runs once per conversation (not per
# prompt) so the standards cost a few dozen tokens per session instead of per message.
# one process per prompt: auto-off check, review-gate snapshot and effort triage together
